# Local, machine-specific environment. NOT tracked in the dotfiles repo.
# Sourced from ~/.zshrc (tracked) via a guarded source line.
# Put secrets here — never in home/.zshrc, which is public.
#
# Add to .gitignore if you ever symlink this into the dotfiles repo like .zshrc.

# GitHub MCP server (remote, PAT auth). Scoped read-only fine-grained token.
# Create at: https://github.com/settings/personal-access-tokens/new
export GITHUB_PERSONAL_ACCESS_TOKEN=""

# Exa — OpenCode websearch (provider exa) + pi-web-tools PI_WEB_TOOLS_EXA_ENDPOINT
# https://dashboard.exa.ai/api-keys
export EXA_API_KEY=""
