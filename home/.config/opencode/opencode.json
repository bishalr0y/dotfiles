{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": [
    "@plannotator/opencode@latest"
  ],
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "description": "Use for Effect (TypeScript) APIs, patterns, and guidance. Guides live in packages/effect/*.md; runnable examples in packages/effect/src and packages/*/test."
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "X-MCP-Toolsets": "context,repos,issues,pull_requests,users,actions",
          "X-MCP-Lockdown": "true"
        }
      }
    }
  }
}
