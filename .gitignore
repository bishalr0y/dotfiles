# Editor/Dotfiles
.undodir/
.DS_Store
.envrc

# opencode
home/.config/opencode/node_modules/
home/.config/opencode/amp_stuff/
.opencode/plans/

# Plugin managers
*/**/node_modules
.config/raycast/*
home/.config/raycast/
.config/cagent
.config/tanstack/*

# Misc
backups/
tmp/
packages/failed_packages_*.txt
configstore/

# Python
__pycache__/
*.pyc

# Herdr runtime/state
home/.config/herdr/*.log
home/.config/herdr/session-history.json
home/.config/herdr/session.json
home/.config/herdr/release-notes.json
home/.config/herdr/plugins.json
home/.config/herdr/plugins/
home/.config/herdr/.plugins.lock
home/.config/herdr/session-snapshots/
home/.config/herdr/*.sock
home/.config/herdr/*.sock.*

# gh CLI: machine-local auth state. hosts.yml can hold an OAuth token in
# plaintext, and gh rewrites config.yml on upgrades -- keep both out of a
# public repo. Review or re-enter on a new machine with `gh auth login`.
home/.config/gh/

# Toki
home/.config/toki/*

# pi agent runtime/state. Track settings, themes, and extensions; ignore
# credentials, sessions, package installs, and MCP auth caches.
home/.pi/node_modules/
home/.pi/agent/*
home/.pi/todos/
home/.pi/.pi/

# pi MCP adapter runtime/secrets
home/.pi/agent/mcp-oauth/
home/.pi/agent/mcp-cache.json
home/.pi/agent/mcp-npx-cache.json
home/.pi/agent/mcp-auth.json

!home/.pi/agent/settings.json
!home/.pi/agent/themes/
!home/.pi/agent/themes/**
!home/.pi/agent/extensions/
!home/.pi/agent/extensions/**

# re-ignore after the extensions un-ignore above (last match wins)
home/.pi/agent/extensions/**/node_modules/

